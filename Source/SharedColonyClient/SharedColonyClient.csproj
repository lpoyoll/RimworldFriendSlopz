<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>RWTSharedColony</AssemblyName>
    <RootNamespace>RWTSharedColony</RootNamespace>
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == ''">$(RimWorldDir)\RimWorldWin64_Data\Managed</RimWorldManagedDir>
    <UseLocalRimWorldReferences Condition="'$(RimWorldDir)' != '' or '$(HarmonyDll)' != ''">true</UseLocalRimWorldReferences>
    <UseLocalRimWorldReferences Condition="'$(UseLocalRimWorldReferences)' == ''">false</UseLocalRimWorldReferences>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalRimWorldReferences)' == 'true'">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalRimWorldReferences)' != 'true'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
    <PackageReference Include="Lib.Harmony.Ref" Version="2.4.2" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RTClient">
      <HintPath>..\Assemblies\RTClient.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RTNetwork">
      <HintPath>..\Assemblies\RTNetwork.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RTShared">
      <HintPath>..\Assemblies\RTShared.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
